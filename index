// ===================== FILE SYSTEM ACCESS =====================
let fsDirectoryHandle = null;
let fsPermissionGranted = false;

async function storeDirectoryHandle(handle) {
  try {
    const tx = db.transaction('permissions', 'readwrite');
    tx.objectStore('permissions').put(handle, 'directoryHandle');
  } catch(e) { console.warn('storeDir:', e); }
}

async function loadDirectoryHandle() {
  return new Promise((resolve) => {
    try {
      const tx = db.transaction('permissions', 'readonly');
      const req = tx.objectStore('permissions').get('directoryHandle');
      req.onsuccess = () => resolve(req.result);
      req.onerror = () => resolve(null);
    } catch(e) { resolve(null); }
  });
}

async function verifyPermission(handle, withPrompt = false) {
  try {
    if (await handle.queryPermission({ mode:'readwrite' }) === 'granted') return true;
    if (withPrompt) {
      if (await handle.requestPermission({ mode:'readwrite' }) === 'granted') return true;
    }
  } catch(e) {}
  return false;
}

let pendingDirectoryHandle = null;

async function initFileSystem() {
  try {
    const handle = await loadDirectoryHandle();
    if (handle) {
      if (await verifyPermission(handle, false)) {
        fsDirectoryHandle = handle;
        fsPermissionGranted = true;
      } else {
        pendingDirectoryHandle = handle;
      }
    }
  } catch(e) {}
  updateFolderStatus();
  return fsPermissionGranted;
}

async function restoreFolderAccess() {
  if (!pendingDirectoryHandle) return false;
  try {
    if (await verifyPermission(pendingDirectoryHandle, true)) {
      fsDirectoryHandle = pendingDirectoryHandle;
      fsPermissionGranted = true;
      pendingDirectoryHandle = null;
      updateFolderStatus();
      return true;
    }
  } catch(e) {}
  return false;
}

