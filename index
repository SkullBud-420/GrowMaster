async function selectFolder() {
  if (!window.showDirectoryPicker) {
    toast('⚠️ Seu navegador não suporta acesso a pastas. Use Chrome ou Edge.');
    return false;
  }
  try {
    const parentHandle = await window.showDirectoryPicker({ mode:'readwrite', startIn:'documents' });
    const growmasterHandle = await parentHandle.getDirectoryHandle('GROWMASTER', { create: true });
    await storeDirectoryHandle(growmasterHandle);
    fsDirectoryHandle = growmasterHandle;
    fsPermissionGranted = true;
    updateFolderStatus();
    toast('📁 Pasta GROWMASTER configurada!');
    // Faz backup imediato
    await backupToFolder();
    return true;
  } catch(e) {
    if (e.name !== 'AbortError') toast('❌ Não foi possível acessar a pasta');
    return false;
  }
}

function updateFolderStatus() {
  const statusEl = document.getElementById('folder-status');
  const nameEl   = document.getElementById('folder-name');
  if (!statusEl || !nameEl) return;
  if (fsPermissionGranted && fsDirectoryHandle) {
    statusEl.style.color = 'var(--green)';
    statusEl.textContent = '✅ Pasta configurada — backup automático ativo';
    nameEl.textContent = '📁 ' + (fsDirectoryHandle.name || 'GROWMASTER');
  } else {
    statusEl.style.color = 'var(--text3)';
    statusEl.textContent = 'Nenhuma pasta selecionada';
    nameEl.textContent = '';
  }
}

async function backupToFolder() {
  if (!fsDirectoryHandle || !fsPermissionGranted) return;
  try {
    const allGrows   = await getAll('grows');
    const allEntries = await getAll('entries');
    const allFerts = JSON.parse(localStorage.getItem('growmaster_fert_lib') || '[]');
    const json = JSON.stringify({ grows: allGrows, entries: allEntries, fertLibrary: allFerts }, null, 2);
    const fileName = 'growmaster_backup_' + new Date().toISOString().slice(0,10) + '.json';
    const fileHandle = await fsDirectoryHandle.getFileHandle(fileName, { create: true });
    const writable = await fileHandle.createWritable();
    await writable.write(json);
    await writable.close();
    toast('💾 Backup salvo na pasta!');
  } catch(e) {
    console.warn('backup error:', e);
    toast('⚠️ Erro ao salvar backup: ' + e.message);
  }
}

async function savePhotoToFolder(base64, growName, dayNum) {
  if (!fsDirectoryHandle || !fsPermissionGranted) return null;
  try {
    // Subpasta por cultivo
    const safeName = growName.replace(/[^a-zA-Z0-9]/g, '_');
    const growFolder = await fsDirectoryHandle.getDirectoryHandle(safeName, { create: true });
    // Converter base64 → Blob
    const mimeType = base64.split(';')[0].split(':')[1] || 'image/jpeg';
    const byteString = atob(base64.split(',')[1]);
    const ab = new ArrayBuffer(byteString.length);
    const ia = new Uint8Array(ab);
    for (let i = 0; i < byteString.length; i++) ia[i] = byteString.charCodeAt(i);
    const blob = new Blob([ab], { type: mimeType });
    const ext = mimeType.split('/')[1] || 'jpg';
    const ts = Date.now();
    const fileName = `dia${dayNum}_${ts}.${ext}`;
    const fileHandle = await growFolder.getFileHandle(fileName, { create: true });
    const writable = await fileHandle.createWritable();
    await writable.write(blob);
    await writable.close();
    return fileName;
  } catch(e) {
    console.warn('savePhoto error:', e);
    return null;
  }
}

async function exportData() {
  const allGrows   = await getAll('grows');
  const allEntries = await getAll('entries');
  const allFerts   = JSON.parse(localStorage.getItem('growmaster_fert_lib') || '[]');
  const data = JSON.stringify({ grows: allGrows, entries: allEntries, fertLibrary: allFerts }, null, 2);
