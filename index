const WEATHER_SVG_SETS = {
  glass: WEATHER_SVG_GLASS,
  pixel: WEATHER_SVG_PIXEL,
  morph: WEATHER_SVG_MORPH,
  neon:  WEATHER_SVG_NEON
};

// Mantém compatibilidade com código existente que usa WEATHER_SVG diretamente
let WEATHER_SVG = WEATHER_SVG_SETS[currentIconStyle] || WEATHER_SVG_GLASS;

// ─── Map WMO codes → icon key (day & night) ───────────────────────────────
function getWeatherIcon(code) {
  const set = WEATHER_SVG_SETS[currentIconStyle] || WEATHER_SVG_GLASS;
  const n = isNight();
  if (code === 0)                        return set[n ? 'moon'         : 'sun'];
  if (code === 1)                        return set[n ? 'crescent'     : 'sunCloud'];
  if (code === 2)                        return set[n ? 'nightPartly'  : 'partlyCloudy'];
  if (code === 3)                        return set[n ? 'nightCloudy'  : 'cloudy'];
  if (code === 45 || code === 48)        return set.fog;
  if (code >= 51 && code <= 55)          return set[n ? 'nightRain'   : 'drizzle'];
  if (code >= 61 && code <= 63)          return set[n ? 'nightRain'   : 'rain'];
  if (code >= 64 && code <= 65)          return set[n ? 'nightRain'   : 'heavyRain'];
  if (code >= 71 && code <= 77)          return set[n ? 'nightSnow'   : 'snow'];
  if (code >= 80 && code <= 82)          return set[n ? 'nightRain'   : 'showers'];
  if (code >= 95)                        return set[n ? 'nightStorm'  : 'storm'];
  return set[n ? 'crescent' : 'default'];
}

function getWeatherIconEmoji(code) {
  const night = isNight();
  if (code === 0) return night ? '🌕' : '☀️';
  if (code === 1) return night ? '🌙' : '🌤️';
  if (code === 2) return night ? '☁️' : '⛅';
  if (code === 3) return '☁️';
  if (code === 45 || code === 48) return '🌫️';
  if (code >= 51 && code <= 55) return '🌦️';
  if (code >= 61 && code <= 65) return '🌧️';
  if (code >= 71 && code <= 77) return '🌨️';
  if (code >= 80 && code <= 82) return '🌧️';
  if (code >= 95) return '⛈️';
  return night ? '🌙' : '🌡️';
}


let weatherCache = null;
let weatherLastFetch = 0;

function updateWeatherClock() {
  const now  = new Date().toLocaleTimeString('pt-BR', {hour:'2-digit', minute:'2-digit'});
  const nowDate = new Date().toLocaleDateString('pt-BR', {weekday:'short', day:'numeric', month:'short'});

  // Home widget time
  const timeEl = document.getElementById('weather-time');
  if (timeEl) timeEl.textContent = now;
  const dateEl2 = document.getElementById('weather-date');
  if (dateEl2) dateEl2.textContent = nowDate;

  // Update "updated X min ago" indicator
  const ageEl = document.getElementById('weather-age');
  if (ageEl && weatherLastFetch > 0) {
    const mins = Math.floor((Date.now() - weatherLastFetch) / 60000);
    if (mins < 1) ageEl.textContent = '· atualizado agora';
    else if (mins === 1) ageEl.textContent = '· há 1 min';
    else ageEl.textContent = `· há ${mins} min`;
  }

  // Live icon update: switch sun↔moon at day/night boundary
  if (weatherCache) {
    const iconEl = document.getElementById('weather-icon');
    if (iconEl) iconEl.innerHTML = getWeatherIcon(weatherCache.code);
  }

  // Grow detail date line (just the time portion)
  const infoDate = document.getElementById('grow-info-date');
  if (infoDate) {
    const d      = new Date();
    const dia    = d.toLocaleDateString('pt-BR', {day:'numeric', month:'long'});
    const semana = d.toLocaleDateString('pt-BR', {weekday:'long'});
    infoDate.textContent = dia + ' · ' + semana + ' · ' + now;
  }
}

