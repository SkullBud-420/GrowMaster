function getDaysBetween(start, end = new Date().toISOString()) {
  const s = new Date(start), e = new Date(end);
  return Math.max(1, Math.ceil((e - s) / 86400000));
}

function formatDate(d) {
  const months = ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];
  return `${d.getDate()} ${months[d.getMonth()]}`;
}

function todayStr() { return new Date().toISOString().slice(0,10); }

function stageLabel(s) {
  const m = { Seedling:'🌱 Seedling', Vegetative:'🌿 Veg', Flowering:'🌸 Floração', Harvested:'✅ Colheita', Curing:'🧪 Cura' };
  return m[s] || s;
}

function calcVPD(temp, humidity) {
  const svp = 0.61078 * Math.exp((17.27 * temp) / (temp + 237.3));
  return svp * (1 - humidity / 100);
}

function getVPDStatus(vpd, stage) {
  // Faixas por estágio
  const ranges = {
    Seedling:   { lo: 0.4, hi: 0.8 },
    Vegetative: { lo: 0.8, hi: 1.2 },
    Flowering:  { lo: 1.0, hi: 1.5 },
    Harvested:  { lo: 0.8, hi: 1.5 },
    Curing:     { lo: 0.8, hi: 1.5 },
  };
  const { lo, hi } = ranges[stage] || ranges.Vegetative;
  const ideal = `${lo}–${hi} kPa`;
  const margin = (hi - lo) * 0.15; // 15% de margem = zona "levemente fora"

  if (vpd < lo - margin)       return { label: 'Muito Úmido',      color: '#60a5fa', ideal, zone: 'verylow'  };
  if (vpd < lo)                return { label: 'Levemente Úmido',  color: '#93c5fd', ideal, zone: 'low'      };
  if (vpd <= hi)               return { label: 'Ideal ✓',          color: '#4ade80', ideal, zone: 'ok'       };
  if (vpd <= hi + margin)      return { label: 'Levemente Seco',   color: '#fbbf24', ideal, zone: 'high'     };
                               return { label: 'Muito Seco',       color: '#f87171', ideal, zone: 'veryhigh' };
}

function getVPDSuggestions(vpd, stage, temp, humidity) {
  const status = getVPDStatus(vpd, stage);
  if (status.zone === 'ok') return [];
  const tips = [];
  if (status.zone === 'low' || status.zone === 'verylow') {
    if (temp !== null) tips.push(`🌡️ Aumentar temperatura (~${(parseFloat(temp)+2).toFixed(0)}°C)`);
    tips.push('💨 Melhorar circulação de ar');
    if (humidity !== null && parseFloat(humidity) > 50) tips.push(`💧 Reduzir umidade (~${(parseFloat(humidity)-5).toFixed(0)}%)`);
  }
  if (status.zone === 'high' || status.zone === 'veryhigh') {
    if (humidity !== null) tips.push(`💧 Aumentar umidade (~${(parseFloat(humidity)+5).toFixed(0)}%)`);
    if (temp !== null) tips.push(`🌡️ Reduzir temperatura (~${(parseFloat(temp)-2).toFixed(0)}°C)`);
    tips.push('🌿 Nebulizar folhas nas horas mais quentes');
  }
  return tips;
}

function getPHStatus(ph) {
  if (ph < 5.5) return { text: 'Muito ácido', color: '#f87171' };
  if (ph < 6.0) return { text: 'Levemente ácido', color: '#fbbf24' };
  if (ph <= 7.0) return { text: 'Ideal ✓', color: '#4ade80' };
  return { text: 'Muito alcalino', color: '#f87171' };
}

function getECStatus(ec, stage) {
  const ranges = { Seedling:[0.4,0.8], Vegetative:[1.2,2.0], Flowering:[1.5,2.5], Harvested:[0,0.5], Curing:[0,0] };
  const [lo,hi] = ranges[stage] || [1.0,2.0];
  if (ec < lo) return { text: 'Abaixo do ideal', color: '#fbbf24' };
  if (ec > hi) return { text: 'Acima do ideal', color: '#f87171' };
  return { text: 'Ideal ✓', color: '#4ade80' };
}

function getTempStatus(t, stage) {
  if (t < 18) return { text: 'Muito frio', color: '#60a5fa' };
  if (t > 30) return { text: 'Muito quente', color: '#f87171' };
  if (t >= 22 && t <= 28) return { text: 'Ideal ✓', color: '#4ade80' };
  return { text: 'Aceitável', color: '#fbbf24' };
}

function getHumStatus(h, stage) {
  const ranges = { Seedling:[65,80], Vegetative:[50,70], Flowering:[40,55], Harvested:[0,0], Curing:[55,65] };
  const [lo,hi] = ranges[stage] || [40,70];
  if (h < lo) return { text: 'Seco', color: '#fb923c' };
  if (h > hi) return { text: 'Úmido', color: '#60a5fa' };
  return { text: 'Ideal ✓', color: '#4ade80' };
}



