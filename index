function drawChart(canvasId, labels, datasets, opts = {}) {
  const canvas = document.getElementById(canvasId);
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const W = canvas.offsetWidth || 300;
  const H = canvas.height || 160;
  canvas.width = W * window.devicePixelRatio;
  canvas.height = H * window.devicePixelRatio;
  ctx.scale(window.devicePixelRatio, window.devicePixelRatio);

  const PAD = { top: 10, right: 10, bottom: 30, left: 36 };
  const w = W - PAD.left - PAD.right;
  const h = H - PAD.top - PAD.bottom;

  // Compute range
  const allVals = datasets.flatMap(d => d.data.filter(v => v !== null)).map(Number);
  let minV = opts.min !== undefined ? opts.min : Math.min(...allVals) * 0.95;
  let maxV = opts.max !== undefined ? opts.max : Math.max(...allVals) * 1.05;
  if (minV === maxV) { minV -= 1; maxV += 1; }

  const toX = (i) => PAD.left + (i / (labels.length - 1)) * w;
  const toY = (v) => PAD.top + h - ((v - minV) / (maxV - minV)) * h;

  ctx.clearRect(0, 0, W, H);

  // Grid
  ctx.strokeStyle = 'rgba(255,255,255,0.05)';
  ctx.lineWidth = 1;
  for (let i = 0; i <= 4; i++) {
    const y = PAD.top + (i / 4) * h;
    ctx.beginPath(); ctx.moveTo(PAD.left, y); ctx.lineTo(PAD.left + w, y); ctx.stroke();
    const val = maxV - (i / 4) * (maxV - minV);
    ctx.fillStyle = 'rgba(255,255,255,0.3)';
    ctx.font = '9px DM Sans';
    ctx.textAlign = 'right';
    ctx.fillText(val.toFixed(1), PAD.left - 4, y + 3);
  }

  // X labels
  ctx.fillStyle = 'rgba(255,255,255,0.25)';
  ctx.font = '9px DM Sans';
  ctx.textAlign = 'center';
  const step = Math.max(1, Math.floor(labels.length / 5));
  labels.forEach((l, i) => {
    if (i % step === 0 || i === labels.length - 1) {
      ctx.fillText(l, toX(i), PAD.top + h + 18);
    }
  });

  // Reference line
  if (opts.ref) {
    ctx.strokeStyle = 'rgba(255,255,255,.15)';
    ctx.setLineDash([4, 4]);
    const ry = toY(opts.ref);
    ctx.beginPath(); ctx.moveTo(PAD.left, ry); ctx.lineTo(PAD.left + w, ry); ctx.stroke();
    ctx.setLineDash([]);
  }

  // Lines
  datasets.forEach(ds => {
    const valid = ds.data.map((v,i) => v !== null ? { x: toX(i), y: toY(Number(v)) } : null);
    // Area
    ctx.beginPath();
    let started = false;
    valid.forEach((pt, i) => {
      if (!pt) return;
      if (!started) { ctx.moveTo(pt.x, pt.y); started = true; }
      else ctx.lineTo(pt.x, pt.y);
    });
    const lastPt = valid.filter(Boolean).pop();
    const firstPt = valid.find(Boolean);
    if (lastPt && firstPt) {
      ctx.lineTo(lastPt.x, PAD.top + h);
      ctx.lineTo(firstPt.x, PAD.top + h);
    }
    ctx.closePath();
    const grad = ctx.createLinearGradient(0, PAD.top, 0, PAD.top + h);
    grad.addColorStop(0, ds.color + '40');
    grad.addColorStop(1, ds.color + '00');
    ctx.fillStyle = grad;
    ctx.fill();

    // Line
    ctx.beginPath();
    started = false;
    valid.forEach((pt) => {
      if (!pt) return;
      if (!started) { ctx.moveTo(pt.x, pt.y); started = true; }
      else ctx.lineTo(pt.x, pt.y);
    });
    ctx.strokeStyle = ds.color;
    ctx.lineWidth = 2;
    ctx.lineJoin = 'round';
    ctx.lineCap = 'round';
    ctx.stroke();

    // Dots
    valid.forEach(pt => {
      if (!pt) return;
      ctx.beginPath();
      ctx.arc(pt.x, pt.y, 3, 0, Math.PI * 2);
      ctx.fillStyle = ds.color;
      ctx.fill();
    });
  });
}

