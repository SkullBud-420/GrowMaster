async function init() {
  await openDB();
  await loadGrows();
  initFileSystem();
  
  // Geolocation permission monitoring
  if (navigator.permissions) {
    const hint = document.getElementById('location-hint');
    const updateHint = (state) => {
      if (!hint) return;
      if (state === 'granted') {
        hint.style.opacity = '1';
        hint.innerHTML = '✅ GPS Ativo · Localização precisa';
        hint.style.color = 'var(--green)';
      } else if (state === 'denied') {
        hint.style.opacity = '1';
        hint.innerHTML = '❌ GPS Negado · Usando estimativa por IP';
        hint.style.color = 'var(--red)';
      } else {
        hint.style.opacity = '0.7';
        hint.innerHTML = '📍 Ative o GPS para clima e bairro reais';
      }
    };
    navigator.permissions.query({name:'geolocation'}).then(res => {
      updateHint(res.state);
      res.onchange = () => updateHint(res.state);
    });
  }

  // fetchWeather is now primarily triggered by enterAppWithRestore to ensure user gesture
  // but we still do a background fetch in case permission was already granted
  fetchWeather();
  setInterval(updateWeatherClock, 1000);
  setInterval(() => fetchWeather(true), 5 * 60 * 1000);
  
  // Efeito neon periódico na dica (cada 8s)
  setInterval(triggerTipNeon, 8000);
  setTimeout(triggerTipNeon, 3000); // Primeiro trigger após carregar

  // Configura o histórico para interceptar o botão voltar de forma limpa
  // Transforma a URL de entrada na "âncora de saída"
  history.replaceState({ page: 'exit' }, '', '#exit');
  // Coloca o usuário dentro do app
  history.pushState({ page: 'app' }, '', '#app');

  window.addEventListener('popstate', (e) => {
    // Se o estado for 'app', significa que o usuário avançou manualmente (raro)
    if (e.state && e.state.page === 'app') return;

    // Se chegou aqui, o usuário tentou voltar para o '#exit'
    
    // 1. Fecha modal aberto
    const openModalEl = document.querySelector('.modal-overlay.open');
    if (openModalEl) { 
      openModalEl.classList.remove('open'); 
      history.pushState({ page: 'app' }, '', '#app'); // Retorna ao app
      return; 
    }

    // 2. Fecha lightbox
    if (document.getElementById('lightbox') && document.getElementById('lightbox').classList.contains('open')) {
      closeLightbox(); 
      history.pushState({ page: 'app' }, '', '#app');
      return;
    }

    // 3. Navega para tela anterior dentro do app
    if (typeof screenStack !== 'undefined' && screenStack.length > 1) {
      cancelExit();
      goBack();
      history.pushState({ page: 'app' }, '', '#app');
      return;
    }

    // 4. Na home — confirmação em duas etapas
    if (!exitConfirmPending) {
      exitConfirmPending = true;
      showExitBanner();
      history.pushState({ page: 'app' }, '', '#app'); // Retorna ao app
      
      // Auto-cancela após 3 segundos
      exitConfirmTimer = setTimeout(() => {
        exitConfirmPending = false;
        hideExitBanner();
      }, 3000);
    } else {
      // Segunda vez — sai de verdade
      cancelExit();
      // Estamos no '#exit'. history.back() nos leva para fora do app!
      window.history.back();
    }
  });
}

