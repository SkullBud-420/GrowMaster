// ===================== KEYBOARD AVOID =====================
// Detecta teclado virtual e empurra o modal para cima
(function() {
  const root = document.documentElement;

  function setKeyboardHeight(h) {
    root.style.setProperty('--keyboard-h', h + 'px');
    // Move todos os modais abertos para cima do teclado
    document.querySelectorAll('.modal-overlay.open').forEach(overlay => {
      overlay.style.bottom = h + 'px';
    });
    // Move o toast também
    const toast = document.getElementById('toast');
    if (toast) toast.style.bottom = (h + 100) + 'px';
  }

  // API moderna: visualViewport (Chrome Android >= 61)
  if (window.visualViewport) {
    let baseHeight = window.visualViewport.height;

    window.visualViewport.addEventListener('resize', () => {
      const newH = window.visualViewport.height;
      // Se o viewport encolheu mais de 80px, provavelmente é o teclado
      const diff = baseHeight - newH;
      const kbH = diff > 80 ? diff : 0;
      setKeyboardHeight(kbH);
    });

    window.visualViewport.addEventListener('scroll', () => {
      // Reposiciona overlays ao scrollar com teclado aberto
      document.querySelectorAll('.modal-overlay.open').forEach(overlay => {
        overlay.style.bottom = (baseHeight - window.visualViewport.height) + 'px';
      });
    });

    // Recalcula a base ao girar a tela
    window.addEventListener('orientationchange', () => {
      setTimeout(() => { baseHeight = window.visualViewport.height; setKeyboardHeight(0); }, 300);
    });
  } else {
    // Fallback para dispositivos mais antigos: escuta focus/blur nos inputs
    const INPUTS = 'input, textarea, select';
    document.addEventListener('focusin', e => {
      if (e.target.matches(INPUTS)) {
        setTimeout(() => {
          const diff = window.screen.height - window.innerHeight;
          if (diff > 80) setKeyboardHeight(diff * 0.6);
        }, 400);
      }
    });
    document.addEventListener('focusout', e => {
      if (e.target.matches(INPUTS)) {
        setTimeout(() => setKeyboardHeight(0), 200);
      }
    });
  }

  // Quando um modal fechar, limpa o offset
  document.addEventListener('click', e => {
    if (e.target.classList.contains('modal-overlay')) {
      setKeyboardHeight(0);
      e.target.style.bottom = '';
    }
  });

  // Garante reset ao fechar modal via closeModal()
  const _origClose = window.closeModal;
  window.closeModal = function(id) {
    _origClose && _origClose(id);
    const el = document.getElementById(id);
    if (el) el.style.bottom = '';
    // Se não há mais modais abertos, zera o keyboard height
    setTimeout(() => {
      if (!document.querySelector('.modal-overlay.open')) setKeyboardHeight(0);
    }, 50);
  };
})();

// Pedir confirmação caso o usuário tente fechar a aba ou recarregar a página
window.addEventListener('beforeunload', function (e) {
  e.preventDefault();
  e.returnValue = '';
});
</script>
</body>
