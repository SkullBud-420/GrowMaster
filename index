// ===================== CALENDAR STATE =====================
let calYear = new Date().getFullYear();
let calMonth = new Date().getMonth();
let calSelectedDate = null; // 'YYYY-MM-DD'
let calOnConfirm = null;

const CAL_MONTHS = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
const CAL_DAYS = ['Dom','Seg','Ter','Qua','Qui','Sex','Sab'];

function openCalModal(onConfirm) {
  const today = new Date();
  calYear = today.getFullYear();
  calMonth = today.getMonth();
  calSelectedDate = null;
  calOnConfirm = onConfirm || null;
  document.getElementById('btn-cal-confirm').disabled = true;
  renderCal();
  openModal('modal-cal');
}

function renderCal() {
  document.getElementById('cal-month-label').textContent = `${CAL_MONTHS[calMonth]} ${calYear}`;
  const grid = document.getElementById('cal-grid');
  const today = new Date(); today.setHours(0,0,0,0);
  const firstDay = new Date(calYear, calMonth, 1).getDay();
  const daysInMonth = new Date(calYear, calMonth+1, 0).getDate();
  const daysInPrev = new Date(calYear, calMonth, 0).getDate();

  let html = CAL_DAYS.map(d => `<div class="cal-day-label">${d}</div>`).join('');

  // prev month padding
  for (let i = firstDay - 1; i >= 0; i--) {
    html += `<div class="cal-day other-month">${daysInPrev - i}</div>`;
  }

  for (let d = 1; d <= daysInMonth; d++) {
    const dateStr = `${calYear}-${String(calMonth+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
    const thisDate = new Date(calYear, calMonth, d);
    const isToday = thisDate.getTime() === today.getTime();
    const isFuture = thisDate > today;
    const isSelected = dateStr === calSelectedDate;
    const cls = ['cal-day', isToday?'today':'', isFuture?'future':'', isSelected?'selected':''].filter(Boolean).join(' ');
    const click = isFuture ? '' : `onclick="calSelectDate('${dateStr}')"`;
    html += `<div class="${cls}" ${click}>${d}</div>`;
  }

  // next month padding
  const totalCells = Math.ceil((firstDay + daysInMonth) / 7) * 7;
  let next = 1;
  for (let i = firstDay + daysInMonth; i < totalCells; i++, next++) {
    html += `<div class="cal-day other-month">${next}</div>`;
  }

  grid.innerHTML = html;
}

function calSelectDate(dateStr) {
  calSelectedDate = dateStr;
  document.getElementById('btn-cal-confirm').disabled = false;
  renderCal();
}

function selectCalToday() {
  const t = new Date();
  calSelectedDate = `${t.getFullYear()}-${String(t.getMonth()+1).padStart(2,'0')}-${String(t.getDate()).padStart(2,'0')}`;
  calYear = t.getFullYear(); calMonth = t.getMonth();
  document.getElementById('btn-cal-confirm').disabled = false;
  renderCal();
}

function calPrevMonth() {
  calMonth--; if (calMonth < 0) { calMonth = 11; calYear--; }
  renderCal();
}

function calNextMonth() {
  const today = new Date();
  if (calYear >= today.getFullYear() && calMonth >= today.getMonth()) return;
  calMonth++; if (calMonth > 11) { calMonth = 0; calYear++; }
  renderCal();
}

function confirmCalDate() {
  if (!calSelectedDate) return;
  closeModal('modal-cal');
  if (calOnConfirm) { calOnConfirm(calSelectedDate); return; }
  // Default: updating grow form
  applyGermDate(calSelectedDate);
}

function applyGermDate(dateStr) {
  const d = new Date(dateStr + 'T12:00:00');
  const label = `${d.getDate()} de ${CAL_MONTHS[d.getMonth()]} de ${d.getFullYear()}`;
  const el = document.getElementById('germ-date-text');
  if (el) { el.textContent = label; el.classList.remove('placeholder'); }
  document.getElementById('grow-germ-date').value = dateStr;
  updateCycleInfo();
}

function updateCycleInfo() {
  const seedType = document.getElementById('grow-seed-type').value;
  const germDate = document.getElementById('grow-germ-date').value;
  const box = document.getElementById('cycle-info-box');
  if (!box) return;

  if (!germDate) { box.style.display='none'; return; }

  const cycle = SEED_CYCLES[seedType] || SEED_CYCLES.Photoperiod;
  const germD = new Date(germDate + 'T12:00:00');
  const harvestD = new Date(germD.getTime() + cycle.total * 86400000);
  const today = new Date(); today.setHours(12,0,0,0);
  const daysIn = Math.max(0, Math.ceil((today - germD) / 86400000));
  const daysLeft = Math.max(0, cycle.total - daysIn);

  // Detect current stage from cycle
  let cumDays = 0;
  let detectedStage = cycle.phases[0].name;
  for (const ph of cycle.phases) {
    cumDays += ph.days;
    if (daysIn <= cumDays) { detectedStage = ph.name; break; }
    detectedStage = ph.name;
  }

  // Auto-set stage select
  const stageEl = document.getElementById('grow-stage');
  if (stageEl && !editingGrowId) stageEl.value = detectedStage;

  // Auto-set custom days
  const customEl = document.getElementById('grow-days-est');
  if (customEl && !customEl.dataset.manual) customEl.value = cycle.total;

  const harvestFmt = `${harvestD.getDate()}/${harvestD.getMonth()+1}/${harvestD.getFullYear()}`;
  const phasesTags = cycle.phases.slice(0,4).map(ph => `<span class="phase-tag" style="color:${ph.color};">${ph.label}: ${ph.days}d</span>`).join('');

  box.style.display = 'block';
  box.innerHTML = `<div class="cycle-info">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;">
      <div>
        <div style="font-weight:700;font-size:13px;">${cycle.label} · ${cycle.total} dias de ciclo</div>
        <div style="color:var(--text2);font-size:11px;margin-top:2px;">${cycle.description}</div>
      </div>
      <div style="text-align:right;">
        <div style="font-size:11px;color:var(--text3);">Colheita estimada</div>
        <div style="font-size:13px;font-weight:700;color:var(--green);">${harvestFmt}</div>
      </div>
    </div>
    <div style="margin-top:10px;padding:8px;background:rgba(0,0,0,.2);border-radius:8px;display:flex;justify-content:space-around;text-align:center;">
      <div><div style="font-family:'Space Mono';font-size:18px;font-weight:700;color:var(--green);">${daysIn}</div><div style="font-size:10px;color:var(--text3);text-transform:uppercase;letter-spacing:.06em;">Dias ativos</div></div>
      <div style="width:1px;background:var(--border);"></div>
      <div><div style="font-family:'Space Mono';font-size:18px;font-weight:700;">${daysLeft}</div><div style="font-size:10px;color:var(--text3);text-transform:uppercase;letter-spacing:.06em;">Para colheita</div></div>
      <div style="width:1px;background:var(--border);"></div>
      <div><div style="font-size:13px;font-weight:700;color:var(--amber);">${stageLabel(detectedStage).split(' ').slice(1).join(' ')||detectedStage}</div><div style="font-size:10px;color:var(--text3);text-transform:uppercase;letter-spacing:.06em;">Estágio atual</div></div>
    </div>
    <div class="cycle-phases" style="margin-top:8px;">${phasesTags}</div>
  </div>`;
}

