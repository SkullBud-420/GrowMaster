        {label:'pH Calda',  data:entries.map(e=>e.phCalda||e.ph||null),       color:'#4ade80'},
        {label:'pH Runoff', data:entries.map(e=>e.runoffPh||null),            color:'#fbbf24'},
      ], {min:4, max:9, ref:6.2});
      if (currentEntries.some(e=>e.height)) {
        drawChart('chart-h', labels, [{label:'Altura cm', data:entries.map(e=>e.height||null), color:'#a78bfa'}]);
