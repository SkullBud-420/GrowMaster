async function saveGrow() {
  const name = document.getElementById('grow-name').value.trim();
  if (!name) { toast('⚠️ Informe o nome do cultivo'); return; }

  const germDate = document.getElementById('grow-germ-date').value;
  if (!germDate) { toast('⚠️ Selecione a data de germinação'); return; }

  const seedType = document.getElementById('grow-seed-type').value;
  const cycle = SEED_CYCLES[seedType] || SEED_CYCLES.Photoperiod;
  const customDaysEl = document.getElementById('grow-days-est');
  const estimatedDays = (customDaysEl.dataset.manual && customDaysEl.value) ? parseInt(customDaysEl.value) : cycle.total;

  const prevStage = editingGrowId ? (grows.find(g=>g.id===editingGrowId)||{}).stage : null;
  const newStage = document.getElementById('grow-stage').value;

  // createdAt = germination date (start of cycle)
  const germISO = germDate + 'T12:00:00.000Z';

  const data = {
    id: editingGrowId || uid(),
    name,
    strain: document.getElementById('grow-strain').value.trim(),
    seedType,
    stage: newStage,
    stageStartDate: (editingGrowId && prevStage === newStage && currentGrow?.stageStartDate) ? currentGrow.stageStartDate : new Date().toISOString(),
    environment: document.getElementById('grow-environment').value,
    space: document.getElementById('grow-space').value.trim(),
    lighting: document.getElementById('grow-lighting').value.trim(),
    substrate: document.getElementById('grow-substrate').value.trim(),
    potSize: document.getElementById('grow-pot').value.trim(),
    estimatedDays,
    germDate,
    seedCycle: cycle,
    createdAt: editingGrowId ? (grows.find(g=>g.id===editingGrowId)||{}).createdAt || germISO : germISO,
    updatedAt: new Date().toISOString()
  };

  await put('grows', data);
  closeModal('modal-grow');

  if (editingGrowId) {
    grows = grows.map(g => g.id === editingGrowId ? data : g);
    currentGrow = data;
    renderGrowDetail();
    toast('✅ Cultivo atualizado!');
  } else {
    grows.unshift(data);
    toast('🌱 Cultivo criado!');
  }
  renderGrowList();
}

function confirmDeleteGrow() {
  showConfirm('🗑️ Excluir Cultivo', `Excluir "${currentGrow.name}" e todos os registros? Esta ação não pode ser desfeita.`, async () => {
