async function importData(event) {
  const file = event.target.files[0];
  if (!file) return;
  const statusEl = document.getElementById('import-status');
  const setStatus = (msg, color) => {
    if (statusEl) { statusEl.textContent = msg; statusEl.style.color = color || 'var(--text3)'; }
  };
  setStatus('⏳ Lendo arquivo...');
  try {
    const text = await file.text();
    const data = JSON.parse(text);
    if (!data.grows || !Array.isArray(data.grows)) {
      setStatus('❌ Arquivo inválido — não é um backup do GrowMaster.', 'var(--red)');
      return;
    }
    const growCount  = data.grows.length;
    const entryCount = (data.entries || []).length;
    const fertCount  = (data.fertLibrary || []).length;
    showConfirm(
      '📥 Importar Backup',
      'Isso irá SUBSTITUIR todos os dados atuais por ' + growCount + ' cultivo(s), ' + entryCount + ' registro(s)' + (fertCount ? ' e ' + fertCount + ' fertilizante(s)' : '') + '. Deseja continuar?',
      async () => {
        setStatus('⏳ Importando dados...');
        try {
          // Limpa dados existentes
          const tx1 = db.transaction(['grows','entries'], 'readwrite');
          await Promise.all([
            new Promise((res,rej) => { const r = tx1.objectStore('grows').clear(); r.onsuccess=res; r.onerror=rej; }),
            new Promise((res,rej) => { const r = tx1.objectStore('entries').clear(); r.onsuccess=res; r.onerror=rej; }),
          ]);
          // Insere backup
          const tx2 = db.transaction(['grows','entries'], 'readwrite');
          const gs = tx2.objectStore('grows');
          const es = tx2.objectStore('entries');
          for (const g of data.grows)          gs.put(g);
          for (const e of (data.entries || [])) es.put(e);
          await new Promise((res,rej) => { tx2.oncomplete=res; tx2.onerror=rej; });
          // Restaura biblioteca de fertilizantes
          if (data.fertLibrary && data.fertLibrary.length) {
            localStorage.setItem('growmaster_fert_lib', JSON.stringify(data.fertLibrary));
            fertLibrary = data.fertLibrary;
          }
          // Recarrega app
          grows = []; currentGrow = null; currentEntries = [];
          await loadGrows();
          setStatus('✅ ' + growCount + ' cultivo(s) e ' + entryCount + ' registro(s) importados!', 'var(--green)');
          toast('✅ Backup importado com sucesso!');
          setTimeout(() => goHome(), 1500);
        } catch(err) {
          setStatus('❌ Erro ao importar: ' + err.message, 'var(--red)');
        }
      },
      '📥'
    );
  } catch(err) {
    setStatus('❌ Arquivo corrompido ou formato inválido.', 'var(--red)');
  }
}

