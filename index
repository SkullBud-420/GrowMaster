<script>
// ===================== INDEXEDDB =====================
const DB_NAME = 'GrowDiaryDB';
const DB_VERSION = 2;
let db;

function openDB() {
  return new Promise((resolve, reject) => {
    const req = indexedDB.open(DB_NAME, DB_VERSION);
    req.onupgradeneeded = (e) => {
      const db = e.target.result;
      if (!db.objectStoreNames.contains('grows')) {
        const gs = db.createObjectStore('grows', { keyPath: 'id' });
        gs.createIndex('createdAt', 'createdAt');
      }
      if (!db.objectStoreNames.contains('entries')) {
        const es = db.createObjectStore('entries', { keyPath: 'id' });
        es.createIndex('growId', 'growId');
        es.createIndex('date', 'date');
      }
      if (!db.objectStoreNames.contains('permissions')) {
        db.createObjectStore('permissions');
      }
    };
    req.onsuccess = e => { db = e.target.result; resolve(db); };
    req.onerror = e => reject(e.target.error);
  });
}

function dbOp(storeName, mode, fn) {
  return new Promise((resolve, reject) => {
    const tx = db.transaction(storeName, mode);
    const store = tx.objectStore(storeName);
    const req = fn(store);
    req.onsuccess = e => resolve(e.target.result);
    req.onerror = e => reject(e.target.error);
  });
}

function getAll(storeName) {
  return new Promise((resolve, reject) => {
    const tx = db.transaction(storeName, 'readonly');
    const store = tx.objectStore(storeName);
    const req = store.getAll();
    req.onsuccess = e => resolve(e.target.result);
    req.onerror = e => reject(e.target.error);
  });
}

function getByIndex(storeName, indexName, value) {
  return new Promise((resolve, reject) => {
    const tx = db.transaction(storeName, 'readonly');
    const store = tx.objectStore(storeName);
    const idx = store.index(indexName);
    const req = idx.getAll(value);
    req.onsuccess = e => resolve(e.target.result);
    req.onerror = e => reject(e.target.error);
  });
}

function put(storeName, obj) { return dbOp(storeName, 'readwrite', s => s.put(obj)); }
function del(storeName, id) { return dbOp(storeName, 'readwrite', s => s.delete(id)); }
function getOne(storeName, id) { return dbOp(storeName, 'readonly', s => s.get(id)); }

function uid() { return Date.now().toString(36) + Math.random().toString(36).slice(2); }

// ===================== STATE =====================
let grows = [];
let currentGrow = null;
let currentEntries = [];
let currentEntry = null;
let editingGrowId = null;
let editingEntryId = null;
let entryPhotos = [];
let fertRows = [];
let screenStack = ['screen-home'];
let currentTab = 'diary';

// ===================== SCREENS =====================
function showScreen(id, direction = 'forward') {
  const cur = document.querySelector('.screen.active');
  if (cur) { cur.classList.remove('active'); cur.classList.add('slide-out'); }
  const next = document.getElementById(id);
  if (direction === 'forward') {
    next.classList.remove('slide-out');
    next.classList.add('slide-in', 'active');
    setTimeout(() => next.classList.remove('slide-in'), 50);
  } else {
    next.classList.remove('slide-in');
    next.classList.add('active');
    cur && setTimeout(() => cur.classList.remove('slide-out'), 300);
  }
  if (!screenStack.includes(id) || screenStack[screenStack.length-1] !== id) {
    screenStack.push(id);
  }
  if (id === 'screen-settings') updateFolderStatus();
}

function goBack() {
  if (screenStack.length < 2) return;
  screenStack.pop();
  const prev = screenStack[screenStack.length - 1];
  const cur = document.querySelector('.screen.active');
  if (cur) cur.classList.remove('active');
  const prevEl = document.getElementById(prev);
  prevEl.classList.remove('slide-out','slide-in');
  prevEl.classList.add('active');
}

function goHome() {
  screenStack = ['screen-home'];
  document.querySelectorAll('.screen').forEach(s => {
    s.classList.remove('active', 'slide-in', 'slide-out');
  });
  document.getElementById('screen-home').classList.add('active');
}

// ===================== MODALS =====================
function openModal(id) { document.getElementById(id).classList.add('open'); }
function closeModal(id) { document.getElementById(id).classList.remove('open'); }

// ===================== TOAST =====================
let toastTimer;
function toast(msg, duration = 2500) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove('show'), duration);
}

// ===================== LOADING =====================
function showLoading(msg = 'Carregando...') {
  document.getElementById('loading-msg').textContent = msg;
  document.getElementById('loading-overlay').classList.add('show');
}
function hideLoading() { document.getElementById('loading-overlay').classList.remove('show'); }

// ===================== GROWS =====================
async function loadGrows() {
  grows = await getAll('grows');
  grows.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
  renderGrowList();
}

function renderGrowList() {
  const list = document.getElementById('grows-list');
  const empty = document.getElementById('grows-empty');
  list.innerHTML = '';
  if (!grows.length) { empty.style.display = 'flex'; return; }
  empty.style.display = 'none';
  grows.forEach(g => {
    const days = getDaysBetween(g.createdAt);
    const total = g.estimatedDays || (SEED_CYCLES[g.seedType]||SEED_CYCLES.Photoperiod).total;
    const germD = new Date(g.createdAt);
    const harvestD = new Date(germD.getTime() + total * 86400000);
    const hFmt = `${harvestD.getDate()}/${harvestD.getMonth()+1}/${harvestD.getFullYear()}`;
    const pct = Math.min((days/total)*100,100).toFixed(0);
    const div = document.createElement('div');
    div.className = 'grow-card';
    div.innerHTML = `

      <div style="position:absolute;inset:0;border-radius:var(--radius);background:linear-gradient(105deg,transparent 40%,rgba(74,222,128,.04) 50%,transparent 60%);background-size:200% 100%;pointer-events:none;"></div>
      <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:10px;position:relative;">
        <div>
          <div style="font-size:16px;font-weight:700;margin-bottom:4px;">${g.name}</div>
          <div style="font-size:12px;color:var(--text2);">${g.strain || '—'} · ${g.seedType||''} · ${g.environment || ''}</div>
        </div>
        <span class="grow-card-badge badge-${g.stage.toLowerCase()}" style="animation:badge-pop .4s cubic-bezier(.34,1.56,.64,1) both;">${stageLabel(g.stage)}</span>
      </div>
      <div style="height:3px;background:var(--bg3);border-radius:3px;margin:8px 0;overflow:hidden;position:relative;">
        <div id="home-bar-${g.id}" style="height:100%;width:0;background:linear-gradient(90deg,var(--green3),var(--green));border-radius:3px;box-shadow:0 0 6px var(--green-glow);transition:width 1s cubic-bezier(.22,1,.36,1);overflow:hidden;">
          <div style="position:absolute;top:0;height:100%;width:40%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.85),transparent);animation:neon-sweep 2.2s ease-in-out infinite;"></div>
        </div>
      </div>
      <div style="display:flex;gap:16px;align-items:center;">
        ${g.lighting ? `<div><div class="label">Luz</div><div style="font-size:12px;margin-top:2px;font-weight:600;">${g.lighting.substring(0,20)}</div></div>` : ''}
        <div><div class="label">Colheita</div><div style="font-size:12px;margin-top:2px;font-weight:600;color:var(--green);text-shadow:0 0 8px rgba(74,222,128,.4);">${hFmt}</div></div>
        <div style="margin-left:auto;text-align:right;">
          <div class="label">Dia</div>
          <div class="mono" style="font-size:20px;font-weight:700;color:var(--green);margin-top:1px;text-shadow:0 0 10px rgba(74,222,128,.35);">${days}<span style="font-size:11px;color:var(--text3);">/${total}</span></div>
        </div>
      </div>`;
    div.onclick = () => openGrow(g.id);
    list.appendChild(div);
    // Animate bar after paint
    requestAnimationFrame(() => {
      setTimeout(() => {
        const bar = document.getElementById('home-bar-' + g.id);
        if (bar) bar.style.width = pct + '%';
      }, 80);
    });
  });
}

async function openGrow(id) {
  currentGrow = grows.find(g => g.id === id);
  if (!currentGrow) return;
  currentEntries = await getByIndex('entries', 'growId', id);
  currentEntries.sort((a,b) => new Date(b.date) - new Date(a.date));
  renderGrowDetail();
  showScreen('screen-grow');
  // Auto-gera dica se não tiver uma de hoje
  if (!currentGrow.lastDailyTip || currentGrow.lastDailyDate !== todayStr()) {
    generateDailyTip(true);
  }
}

function renderGrowDetail() {
  if (!currentGrow) return;
  const g = currentGrow;
  document.getElementById('grow-title').textContent = g.name;
  const days = getDaysBetween(g.createdAt);
  document.getElementById('grow-days').textContent = 'dia ' + days + (g.estimatedDays ? ' / ' + g.estimatedDays : '');
  const badge = document.getElementById('grow-stage-badge');
  badge.className = 'grow-card-badge badge-' + g.stage.toLowerCase();
  badge.textContent = stageLabel(g.stage);
  renderTimeline(g);
  updateGrowInfoLine();
  // Reset to diary tab
  currentTab = 'diary';
  const tabEls = document.getElementById('grow-tabs').children;
  ['diary','metrics'].forEach((t, i) => {
    const el = document.getElementById('tab-'+t);
    if (el) el.style.display = t === 'diary' ? 'block' : 'none';
    if (tabEls[i]) tabEls[i].classList.toggle('active', t === 'diary');
  });
  renderEntries();
  renderDiaryTip();
}

function renderTimeline(g) {
  // Colheita e Cura são fundidos num único dot final "Pós-Floração"
  // O ícone e label mudam conforme o estágio atual
  const isPostFlora = g.stage === 'Harvested' || g.stage === 'Curing';
  const postIcon  = g.stage === 'Curing' ? '🧪' : '✅';
  const postLabel = g.stage === 'Curing' ? 'Cura' : 'Colheita';

  const stages = [
    { id:'Seedling',   label:'Seed',     icon:'🌱' },
    { id:'Vegetative', label:'Veg',      icon:'🌿' },
    { id:'Flowering',  label:'Floração', icon:'🌸' },
    // dot único para Colheita+Cura — ícone/label dinâmico
    { id:'PostFlora',  label: postLabel, icon: postIcon, ids:['Harvested','Curing'] }
  ];

  // curIdx: se estiver em Harvested ou Curing, aponta para o último dot (3)
  const curIdx = isPostFlora ? 3 : stages.findIndex(s => s.id === g.stage);

  const days  = getDaysBetween(g.createdAt);
  const total = g.estimatedDays || (SEED_CYCLES[g.seedType]||SEED_CYCLES.Photoperiod).total;
  const cycle = g.seedCycle || SEED_CYCLES[g.seedType] || SEED_CYCLES.Photoperiod;

  // ── Posição de cada dot: início da sua fase em % do total ──
  // Seedling=0%, Veg=após Seedling, Flowering=após Veg, PostFlora=após Flowering
  let cumDays = 0;
  const phaseOrder = ['Seedling','Vegetative','Flowering','PostFlora'];
  const dotPositions = phaseOrder.map((id) => {
    const pos = Math.min((cumDays / total) * 100, 100);
    // avança pelos dias da fase (PostFlora soma Harvested+Curing)
    if (id === 'PostFlora') {
      const h = cycle.phases.find(p => p.name === 'Harvested');
      const c = cycle.phases.find(p => p.name === 'Curing');
      cumDays += (h?.days||0) + (c?.days||0);
    } else {
      const ph = cycle.phases.find(p => p.name === id);
      if (ph) cumDays += ph.days;
    }
    return pos;
  });
  // último dot sempre em 100%
  dotPositions[3] = 100;

  // ── Progresso real por dias ──
  const prog = Math.min((days / total) * 100, 100);

  // ── Fundo colorido por fase (mantém os 5 segmentos originais) ──
  let cumPct = 0;
  const segments = cycle.phases.map(ph => {
    const pct = (ph.days / total) * 100;
    const seg = { pct, start: cumPct, color: ph.color };
    cumPct += pct;
    return seg;
  });

  // ── Cor da fase atual para o glow ──
  const curPhase = cycle.phases.find(p => p.name === g.stage);
  const curColor = curPhase?.color || '#4ade80';

  const germD    = new Date(g.createdAt);
  const harvestD = new Date(germD.getTime() + total * 86400000);
  const hFmt     = `${harvestD.getDate()}/${harvestD.getMonth()+1}`;
  const sweepDur = Math.max(1.6, prog / 100 * 2.8);

  // Fases visíveis para o gradiente (até curIdx, mapeando PostFlora → Curing)
  const gradPhases = ['Seedling','Vegetative','Flowering','Curing'];

  const tl = document.getElementById('grow-timeline');
  tl.innerHTML = `
    <div style="position:relative;margin:0 12px;">

      <!-- Fundo colorido por fase -->
      <div style="height:4px;border-radius:4px;overflow:hidden;display:flex;margin-bottom:28px;background:var(--bg3);">
        ${segments.map(s=>`<div style="flex:${s.pct};background:${prog>s.start?s.color+'33':'transparent'};min-width:0;transition:background .6s;"></div>`).join('')}
      </div>

      <!-- Barra — gradiente multi-fase com degrade suave em cada dot -->
      <div id="tl-fill" style="
        position:absolute;top:0;left:0;
        height:4px;border-radius:4px;width:0;
        background:${(()=>{
          const blend = 4;
          const stops = [];
          for (let pi = 0; pi <= curIdx; pi++) {
            const phName = gradPhases[pi];
            const ph = cycle.phases.find(p => p.name === phName);
            if (!ph) continue;
            const c = ph.color;
            const barPct = prog > 0 ? (dotPositions[pi] / prog) * 100 : 0;
            if (pi === 0) {
              stops.push(c + ' 0%');
            } else {
              const prevPh = cycle.phases.find(p => p.name === gradPhases[pi-1]);
              const fadeStart = Math.max(0, barPct - blend);
              stops.push((prevPh?.color||c) + ' ' + fadeStart.toFixed(1) + '%');
              stops.push(c + ' ' + barPct.toFixed(1) + '%');
            }
          }
          stops.push(curColor + ' 100%');
          return 'linear-gradient(90deg, ' + stops.join(', ') + ')';
        })()};
        box-shadow:0 0 6px 1px ${curColor}55, 0 0 14px 2px ${curColor}22;
        transition:width .9s cubic-bezier(.22,1,.36,1);
        overflow:hidden;
      ">
        <div style="
          position:absolute;top:0;height:100%;width:30%;
          background:linear-gradient(90deg,transparent,rgba(255,255,255,.9),transparent);
          animation:neon-sweep ${sweepDur}s ease-in-out infinite;
          border-radius:4px;
        "></div>
      </div>

      <!-- Container para Pin e Dots (compartilham o mesmo topo e sistema de coordenadas) -->
      <div style="position:absolute;top:-9px;left:0;right:0;">
        
        <!-- Pin Móvel (Thumb) -->
        <div id="tl-pin" style="
          position:absolute;top:0;left:0;
          width:22px;height:22px;border-radius:50%;
          background:var(--green-dim);
          border:2px solid var(--green);
          box-shadow:0 0 10px var(--green-glow);
          transform:translateX(-50%);
          transition:left .9s cubic-bezier(.22,1,.36,1);
          z-index:5;
          pointer-events:none;
          display:${prog > 0 ? 'flex' : 'none'};
          align-items:center;justify-content:center;
          font-size:10px;
          animation:neon-breathe 2.4s ease-in-out infinite;
        ">
          <div style="
            position:absolute;top:0;left:0;
            width:100%;height:100%;border-radius:50%;
            border:2px solid var(--green);
            animation:pin-ripple 2.5s cubic-bezier(0, 0.2, 0.8, 1) infinite;
            pointer-events:none;
            z-index:-1;
            box-sizing:border-box;
          "></div>
          <div style="
            position:absolute;top:0;left:0;
            width:100%;height:100%;border-radius:50%;
            border:1px solid var(--green);
            animation:pin-ripple 2.5s cubic-bezier(0, 0.2, 0.8, 1) infinite 1.25s;
            pointer-events:none;
            z-index:-1;
            box-sizing:border-box;
          "></div>
          ${(()=>{
          let cum = 0;
          const pCount = cycle.phases.length;
          for(let i=0; i<pCount; i++) {
            const ph = cycle.phases[i];
            cum += (ph.days / total) * 100;
            if (prog <= cum + 0.1 || i === pCount - 1) return ph.icon || '🌱';
          }
          return '🌱';
        })()}</div>

        <!-- 4 dots: Semente · Veg · Floração · Colheita/Cura -->
        ${stages.map((s, i) => {
          const done   = i < curIdx;
          const active = i === curIdx;
          const future = i > curIdx;
          const passed = prog >= dotPositions[i];
          const leftPct    = dotPositions[i];
          const isFuture   = future && !passed;
          return `
          <div style="position:absolute;left:${leftPct}%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;">
            <div style="
              width:22px;height:22px;border-radius:50%;font-size:10px;
              display:flex;align-items:center;justify-content:center;
              border:2px solid ${done||passed?'var(--green3)':active?'var(--green)':'var(--border2)'};
              background:${done||passed?'var(--green3)':active?'var(--green-dim)':'var(--bg3)'};
              ${active?'animation:neon-breathe 2.4s ease-in-out infinite;':''}
              opacity:${isFuture?'0.4':'1'};
              transition:all .3s;
            ">${s.icon}</div>
            <div style="
              font-size:8px;margin-top:6px;white-space:nowrap;
              font-weight:${active?700:600};
              text-transform:uppercase;letter-spacing:.06em;
              color:${active?'var(--green)':done||passed?'var(--text2)':'var(--text3)'};
              opacity:${isFuture?'0.4':'1'};
              ${active?'text-shadow:0 0 8px rgba(74,222,128,.6);':''}
            ">${s.label}</div>
          </div>`;
        }).join('')}
      </div>
    </div>

    <div style="display:flex;justify-content:space-between;margin-top:4px;font-size:10px;color:var(--text3);">
      <span>Dia ${days}</span>
      <span style="color:var(--green2);font-weight:700;text-shadow:0 0 8px rgba(74,222,128,.4);">📅 Colheita ~${hFmt}</span>
      <span>${total}d total</span>
    </div>`;

  requestAnimationFrame(() => {
    setTimeout(() => {
      const fill = document.getElementById('tl-fill');
      const pin = document.getElementById('tl-pin');
      if (fill) fill.style.width = prog + '%';
      if (pin) pin.style.left = prog + '%';
    }, 60);
  });
}

