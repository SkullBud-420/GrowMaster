function handlePhotoUpload(e) {
  const files = Array.from(e.target.files);
  let loaded = 0;
  files.forEach(file => {
    const reader = new FileReader();
    reader.onload = (ev) => {
      // Compress image
      const img = new Image();
      img.onload = () => {
        const canvas = document.createElement('canvas');
        const MAX = 1200;
        let w = img.width, h = img.height;
        if (w > MAX) { h = h * MAX / w; w = MAX; }
        if (h > MAX) { w = w * MAX / h; h = MAX; }
        canvas.width = w; canvas.height = h;
        canvas.getContext('2d').drawImage(img, 0, 0, w, h);
        entryPhotos.push(canvas.toDataURL('image/jpeg', 0.82));
        loaded++;
        if (loaded === files.length) renderPhotoGrid();
      };
      img.src = ev.target.result;
    };
    reader.readAsDataURL(file);
  });
}

// ---- EC-based fert system ----
// Each fertilizer contributes an EC portion to the final solution.
// The total EC of the mix = sum of all fert EC contributions.
// All feedings are watered-in until brief runoff (no pooling in saucer).

function calcTotalEC(rows) {
  return rows.reduce((sum, f) => sum + (parseFloat(f.ec) || 0), 0);
}

function ecBarColor(val) {
  if (val <= 0.5) return '#60a5fa';
  if (val <= 1.2) return '#4ade80';
  if (val <= 2.0) return '#fbbf24';
  return '#f87171';
}

