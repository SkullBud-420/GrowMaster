}

// Called from entry form photos — closes modal first, reopens on exit
function openFormPhotoLightbox(idx) {
  closeModal('modal-entry');
  lbOpen([...entryPhotos], idx, '', '', () => openModal('modal-entry'));
}

function lbOpen(photos, idx, oldSrc, oldLabel, onClose) {
  if (!photos || !photos.length) return;
  _lb.photos         = photos;
  _lb.idx            = idx;
  _lb.compareOld     = oldSrc;
  _lb.compareOldLabel = oldLabel;
  _lb.onClose        = onClose;
  _lb.comparing      = false;

  // Show single, hide compare
  document.getElementById('lb-stage').style.display   = 'flex';
  document.getElementById('lb-compare').style.display = 'none';

  // Compare btn
  const cmpBtn = document.getElementById('lb-compare-btn');
  if (cmpBtn) cmpBtn.style.display = oldSrc ? 'flex' : 'none';

  lbShowPhoto(idx);

  const lb = document.getElementById('lightbox');
  lb.classList.add('open');

  // Init pinch zoom on the img
  lbInitPinch(document.getElementById('lb-img'));

  // Swipe-down to close
  lbInitSwipeDown(lb);
}

function lbShowPhoto(idx) {
  const img = document.getElementById('lb-img');
  img.style.transition = 'none';
  img.style.transform  = 'translate(0,0) scale(1)';
  img.src = _lb.photos[idx];
  const total = _lb.photos.length;
  document.getElementById('lb-caption').textContent =
    total > 1 ? `${idx+1} / ${total}` : '';
}

function lbClose() {
  const lb = document.getElementById('lightbox');
  lb.classList.remove('open');
  _lb.comparing = false;
  if (typeof _lb.onClose === 'function') {
    const cb = _lb.onClose;
    _lb.onClose = null;
    setTimeout(cb, 220);
  }
}

// Keep old name working (called from popstate handler)
function closeLightbox() { lbClose(); }

function lbBgClick(e) {
  // Close only if clicking the backdrop itself, not the image
  if (e.target === document.getElementById('lightbox')) lbClose();
}

function lbToggleCompare() {
  if (!_lb.compareOld) return;
  _lb.comparing = !_lb.comparing;
  if (_lb.comparing) {
    document.getElementById('lb-cmp-new').src = _lb.photos[_lb.idx];
    document.getElementById('lb-cmp-old').src = _lb.compareOld;
    document.getElementById('lb-cmp-label').textContent = _lb.compareOldLabel || '7 dias atrás';
    document.getElementById('lb-stage').style.display   = 'none';
    document.getElementById('lb-compare').style.display = 'block';
    document.getElementById('lb-caption').textContent   = 'Atual vs 7 dias atrás';
  } else {
    document.getElementById('lb-stage').style.display   = 'flex';
    document.getElementById('lb-compare').style.display = 'none';
    lbShowPhoto(_lb.idx);
  }
}

// ── Pinch zoom & pan ────────────────────────────────────────────
function lbInitPinch(img) {
  img._pzVer = (img._pzVer || 0) + 1;
  const myVer = img._pzVer;

  let scale    = 1;
  let panOffX  = 0, panOffY = 0;

  let gesture      = null;
  let startScale   = 1, startDist = 0;
  let startMidX    = 0, startMidY = 0;
  let startPanX    = 0, startPanY = 0;
  let startPanOffX = 0, startPanOffY = 0;
  let lastTap      = 0;

  img.style.transformOrigin = 'center center';
  img.style.willChange      = 'transform';

  function apply(instant) {
    img.style.transition = instant ? 'none' : 'transform .2s ease';
    img.style.transform  = 'translate(' + panOffX + 'px,' + panOffY + 'px) scale(' + scale + ')';
  }

  function clamp() {
    // getBoundingClientRect already reflects current transform
    // so we need the BASE size (scale=1) to compute overflow
    const baseW = img.offsetWidth;
    const baseH = img.offsetHeight;
    const sw    = baseW * scale;
    const sh    = baseH * scale;
    const vw    = window.innerWidth;
    const vh    = window.innerHeight;
    const maxX  = Math.max(0, (sw - vw) / 2);
    const maxY  = Math.max(0, (sh - vh) / 2);
    panOffX = Math.min(maxX, Math.max(-maxX, panOffX));
    panOffY = Math.min(maxY, Math.max(-maxY, panOffY));
  }

  function resetToFit(animated) {
    scale = 1; panOffX = 0; panOffY = 0;
    img._pzScale = 1;
    img.style.transition = animated ? 'transform .25s ease' : 'none';
    img.style.transform  = 'none';
  }

  function touchDist(t) {
    return Math.hypot(t[0].clientX - t[1].clientX, t[0].clientY - t[1].clientY);
  }
  function touchMid(t) {
    return { x: (t[0].clientX + t[1].clientX) / 2, y: (t[0].clientY + t[1].clientY) / 2 };
  }

  img.addEventListener('touchstart', function(e) {
    if (img._pzVer !== myVer) return;
    if (e.touches.length === 2) {
      e.preventDefault();
      gesture      = 'pinch';
      startDist    = touchDist(e.touches);
      startScale   = scale;
      const m      = touchMid(e.touches);
      startMidX    = m.x; startMidY = m.y;
      startPanOffX = panOffX; startPanOffY = panOffY;
    } else if (e.touches.length === 1) {
      if (scale > 1) { e.preventDefault(); gesture = 'pan'; }
      else gesture = 'tap';
      startPanX    = e.touches[0].clientX;
      startPanY    = e.touches[0].clientY;
      startPanOffX = panOffX; startPanOffY = panOffY;
    }
  }, { passive: false });

  img.addEventListener('touchmove', function(e) {
    if (img._pzVer !== myVer) return;
    if (e.touches.length === 2 && gesture === 'pinch') {
      e.preventDefault();
      const nd  = touchDist(e.touches);
      const ns  = Math.min(Math.max(startScale * (nd / startDist), 1), 6);
      const m   = touchMid(e.touches);
      const r   = ns / startScale;
      // keep the pinch midpoint visually fixed
      panOffX   = m.x - window.innerWidth  / 2 + r * (startPanOffX - (startMidX - window.innerWidth  / 2));
      panOffY   = m.y - window.innerHeight / 2 + r * (startPanOffY - (startMidY - window.innerHeight / 2));
      scale     = ns;
      img._pzScale = scale;
      clamp();
      apply(true);
    } else if (e.touches.length === 1 && gesture === 'pan') {
      e.preventDefault();
      panOffX = startPanOffX + (e.touches[0].clientX - startPanX);
      panOffY = startPanOffY + (e.touches[0].clientY - startPanY);
      clamp();
      apply(true);
    }
  }, { passive: false });

  img.addEventListener('touchend', function(e) {
    if (img._pzVer !== myVer) return;

    // When all fingers lift
    if (e.touches.length === 0) {
      // If scale snapped below 1 somehow, reset
      if (scale < 1) { resetToFit(true); gesture = null; return; }
      gesture = null;

      // Double-tap detection
      const now = Date.now();
      const dt  = now - lastTap;
      lastTap   = now;
      if (dt < 280 && e.changedTouches.length === 1) {
        e.preventDefault();
        if (scale > 1) {
          resetToFit(true);
        } else {
          const t = e.changedTouches[0];
          scale   = 3;
          img._pzScale = 3;
          panOffX = (window.innerWidth  / 2 - t.clientX) * (scale - 1);
          panOffY = (window.innerHeight / 2 - t.clientY) * (scale - 1);
          clamp();
          apply(false);
        }
      }
      // No reset here — zoom stays where it was
    }

    // One finger lifted during pinch → switch to pan mode
    if (e.touches.length === 1 && gesture === 'pinch') {
      gesture      = 'pan';
      startPanX    = e.touches[0].clientX;
      startPanY    = e.touches[0].clientY;
      startPanOffX = panOffX;
      startPanOffY = panOffY;
    }
  }, { passive: false });
}

function lbInitSwipeDown(lb) {
  let startY = 0;
  let startX = 0;
  lb.addEventListener('touchstart', e => {
    if (e.touches.length === 1) {
      startY = e.touches[0].clientY;
      startX = e.touches[0].clientX;
    }
  }, { passive: true });
  lb.addEventListener('touchend', e => {
    const img = document.getElementById('lb-img');
    // Only close if: not zoomed, single finger, mostly vertical swipe down
    if (img && (img._pzScale || 1) > 1) return;
    const dy = e.changedTouches[0].clientY - startY;
    const dx = Math.abs(e.changedTouches[0].clientX - startX);
    if (dy > 90 && dx < 60) lbClose();
  }, { passive: true });
}



