async function fetchWeather(force) {
  // Throttle: skip if fetched within 5 min and not forced
  if (!force && weatherLastFetch > 0 && (Date.now() - weatherLastFetch) < 5 * 60 * 1000) return;

  _startRefreshSpin();

  const widget = document.getElementById('weather-widget');
  const descEl = document.getElementById('weather-desc');
  if (widget) widget.style.display = 'block';
  if (descEl && !weatherCache) descEl.textContent = 'Buscando GPS...';

  // 1. GPS — PRIORIDADE ABSOLUTA
  // Solicitamos alta precisão para forçar o chip de GPS do Android
  const coords = await new Promise(resolve => {
    if (!navigator.geolocation) return resolve(null);
    let done = false;
    const finish = (v) => { if (!done) { done = true; resolve(v); } };

    navigator.geolocation.getCurrentPosition(
      p => finish({ 
        lat: +p.coords.latitude.toFixed(6), 
        lon: +p.coords.longitude.toFixed(6), 
        acc: p.coords.accuracy,
        source: 'GPS'
      }),
      (err) => {
        console.warn('GPS High Accuracy failed:', err.message);
        // Fallback rápido: triangulação por rede
        navigator.geolocation.getCurrentPosition(
          p => finish({ 
            lat: +p.coords.latitude.toFixed(6), 
            lon: +p.coords.longitude.toFixed(6), 
            acc: p.coords.accuracy,
            source: 'Rede/Wifi'
          }),
          () => finish(null),
          { timeout: 8000, maximumAge: 0, enableHighAccuracy: false }
        );
      },
      { timeout: 15000, maximumAge: 0, enableHighAccuracy: true }
    );
  });

  // 2. Fallback por IP (apenas se GPS falhar totalmente)
  let bestCoords = coords;
  let cityName = '';
  let isIP = false;

  if (!bestCoords) {
    isIP = true;
    try {
      const r = await fetch('https://ipwho.is/', { signal: AbortSignal.timeout(4000) });
      const d = await r.json();
      if (d.latitude) {
        bestCoords = { lat: d.latitude, lon: d.longitude, acc: 50000, source: 'IP' };
        if (d.city) cityName = d.city + (d.region_code ? ', ' + d.region_code : '');
      }
    } catch(e) {
      try {
        const r2 = await fetch('https://ipapi.co/json/', { signal: AbortSignal.timeout(4000) });
        const d2 = await r2.json();
        if (d2.latitude) {
          bestCoords = { lat: d2.latitude, lon: d2.longitude, acc: 50000, source: 'IP' };
          if (d2.city) cityName = d2.city + (d2.region_code ? ', ' + d2.region_code : '');
        }
      } catch(e2) { console.warn('IP Location failed'); }
    }
  }

  // Padrão: São Paulo
  if (!bestCoords) {
    bestCoords = { lat: -23.5505, lon: -46.6333, source: 'Padrão' };
    cityName = 'São Paulo, SP';
  }

  // 3. Reverse geocode via Nominatim
  if (!cityName || !isIP) {
    try {
      const rg = await fetch(
        `https://nominatim.openstreetmap.org/reverse?lat=${bestCoords.lat}&lon=${bestCoords.lon}&format=jsonv2&zoom=14&addressdetails=1&accept-language=pt-BR`,
        { signal: AbortSignal.timeout(6000), headers: { 'User-Agent': 'GrowMasterApp/1.0' } }
      );
      const gd = await rg.json();
      const a = gd.address || {};

      const bairro = a.suburb || a.neighbourhood || a.quarter || a.village_district || a.residential || '';
      const cidade = a.city || a.town || a.village || a.municipality || a.city_district || a.county || '';
      
      let estado = '';
      if (a.state_code) {
        estado = a.state_code.includes('-') ? a.state_code.split('-')[1] : a.state_code;
      } else if (a.state) {
        const BR_STATES = {
          'Acre':'AC','Alagoas':'AL','Amapá':'AP','Amazonas':'AM','Bahia':'BA',
          'Ceará':'CE','Distrito Federal':'DF','Espírito Santo':'ES','Goiás':'GO',
          'Maranhão':'MA','Mato Grosso':'MT','Mato Grosso do Sul':'MS','Minas Gerais':'MG',
          'Pará':'PA','Paraíba':'PB','Paraná':'PR','Pernambuco':'PE','Piauí':'PI',
          'Rio de Janeiro':'RJ','Rio Grande do Norte':'RN','Rio Grande do Sul':'RS',
          'Rondônia':'RO','Roraima':'RR','Santa Catarina':'SC','São Paulo':'SP',
          'Sergipe':'SE','Tocantins':'TO'
        };
        estado = BR_STATES[a.state] || a.state.substring(0, 2).toUpperCase();
      }

      const rawCity = [bairro, cidade, estado].filter(Boolean).join(', ');
      cityName = rawCity || gd.display_name?.split(',').slice(0, 3).join(', ') || cityName;
    } catch(e) { console.warn('Nominatim failed:', e); }
  }

  // 4. Clima — Open-Meteo
  try {
    const r = await fetch(
      `https://api.open-meteo.com/v1/forecast?latitude=${bestCoords.lat}&longitude=${bestCoords.lon}` +
      `&current=temperature_2m,relative_humidity_2m,weather_code,wind_speed_10m,apparent_temperature` +
      `&wind_speed_unit=kmh&timezone=auto`,
      { signal: AbortSignal.timeout(6000) }
    );
    if (r.ok) {
      const d = await r.json();
      const cur = d.current;
      const result = {
        temp: Math.round(cur.temperature_2m),
        feels: Math.round(cur.apparent_temperature),
        humidity: cur.relative_humidity_2m,
        wind: Math.round(cur.wind_speed_10m),
        code: cur.weather_code,
        desc: (WMO_CODES[cur.weather_code] || '').replace(/^[^\s]+\s/, ''),
        location: cityName,
        source: bestCoords.source,
        acc: bestCoords.acc
      };
      weatherCache = result;
      weatherLastFetch = Date.now();
      renderWeather(result);
      return;
    }
  } catch(e) { console.warn('Open-Meteo failed:', e); }

  if (descEl) descEl.textContent = 'Erro ao carregar clima. Tente novamente.';

  // === PRIORIDADE 2: wttr.in ===
  try {
    const r = await fetch(`https://wttr.in/${bestCoords.lat},${bestCoords.lon}?format=j1`, { signal: AbortSignal.timeout(6000) });
    if (r.ok) {
      const d = await r.json();
      const cur = d.current_condition[0];
      const result = {
        temp: parseInt(cur.temp_C),
        feels: parseInt(cur.FeelsLikeC),
        humidity: parseInt(cur.humidity),
        wind: parseInt(cur.windspeedKmph),
        code: _wttrToWMO(parseInt(cur.weatherCode)),
        desc: cur.weatherDesc?.[0]?.value || '',
        location: cityName,
        source: 'wttr.in',
      };
      weatherCache = result;
      weatherLastFetch = Date.now();
      renderWeather(result);
      return;
    }
  } catch(e) { console.warn('wttr.in failed:', e); }

  // === PRIORIDADE 3: Groq IA (último recurso) ===
  const locString = cityName || (bestCoords.lat + ', ' + bestCoords.lon);
  try {
    const result = await _fetchWeatherByGroqSearch(locString);
    if (result) {
      weatherCache = result;
      weatherLastFetch = Date.now();
      renderWeather(result);
      return;
    }
  } catch(e) { console.warn('Groq Weather failed:', e); }

  if (descEl) descEl.textContent = 'Erro ao carregar clima. Toque em Atualizar.';
}

/**
 * Enhanced Groq weather search
 * Uses Llama 3.3 70B for reasoning and simulated web search for real-time accuracy.
 */
async function _fetchWeatherByGroqSearch(location) {
  const key = getGroqKey();
  if (!key) return null;

  const now = new Date();
  const timestamp = now.toLocaleDateString('pt-BR') + ' ' + now.toLocaleTimeString('pt-BR');
  
  const systemPrompt = `Você é um especialista meteorológico. Sua tarefa é fornecer dados meteorológicos ATUAIS e REAIS para a localização solicitada.
Você deve simular uma busca em tempo real para obter os dados mais próximos do momento ${timestamp}.`;

  const userQuery = `Localização solicitada: ${location}.
Retorne APENAS um objeto JSON (sem markdown, sem texto antes ou depois):
{"temp": número, "feels": número, "humidity": número, "wind": número, "desc": "uma ou duas palavras em português", "station": "Bairro, Cidade, Estado"}

Exemplo: {"temp": 25, "feels": 26, "humidity": 70, "wind": 12, "desc": "Ensolarado", "station": "Batel, Curitiba, PR"}`;

  try {
    const resp = await fetch('https://api.groq.com/openai/v1/chat/completions', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${key}` },
      body: JSON.stringify({
        model: 'llama-3.3-70b-versatile',
        max_tokens: 200,
        temperature: 0,
        messages: [{ role: 'system', content: systemPrompt }, { role: 'user', content: userQuery }]
      })
    });

    if (!resp.ok) return null;
    const data = await resp.json();
    const content = data.choices?.[0]?.message?.content?.trim() || '';
    
    // Robust parsing
    const match = content.match(/\{[\s\S]*?\}/);
    if (!match) return null;
    
    const d = JSON.parse(match[0]);
    if (typeof d.temp !== 'number') return null;
    
    return {
      temp: Math.round(d.temp),
      feels: Math.round(d.feels || d.temp),
      humidity: Math.round(d.humidity || 50),
      wind: Math.round(d.wind || 0),
      code: _descToWMO(d.desc),
      desc: d.desc || 'Desconhecido',
      location: d.station || location,
      fromAI: true
    };
  } catch (e) {
    console.warn('Groq Weather Search failed:', e);
    return null;
  }
}

function _descToWMO(desc) {
  const d = (desc || '').toLowerCase();
  if (d.includes('sol') || d.includes('limpo')) return 0;
  if (d.includes('nublado') || d.includes('nuven')) return 3;
  if (d.includes('chuva')) return 61;
  if (d.includes('tempesta') || d.includes('pancada')) return 80;
  return 2; // Parcialmente nublado padrão
}


function _wttrToWMO(code) {
  if (code === 113) return 0;
  if (code === 116) return 2;
  if (code === 119 || code === 122) return 3;
  if (code >= 143 && code <= 248) return 45;
  if (code >= 263 && code <= 321) return 61;
  if (code >= 353 && code <= 359) return 80;
  if (code >= 371 && code <= 395) return 71;
  if (code >= 389 && code <= 392) return 95;
  return 2;
}

// ===================== LUNAR ENGINE =====================
// Cálculo astronômico local — sem API, funciona offline
function getLunarData(date = new Date()) {
  // Algoritmo baseado em Jean Meeus "Astronomical Algorithms"
  // Fase lunar: 0=Nova, 0.25=Crescente, 0.5=Cheia, 0.75=Minguante
  const JD = date.getTime() / 86400000 + 2440587.5; // Julian Date
  const T  = (JD - 2451545.0) / 36525;              // Julian centuries from J2000

  // Anomalia média da lua
  let M  = 357.52911 + 35999.05029 * T;
  let Ml = 134.96298 + 477198.867398 * T;
  // Argumento da latitude
  let F  = 93.27191 + 483202.017538 * T;
  // Elongação média
  let D  = 297.85036 + 445267.111480 * T;

  M  = (M  % 360 + 360) % 360;
  Ml = (Ml % 360 + 360) % 360;
  F  = (F  % 360 + 360) % 360;
  D  = (D  % 360 + 360) % 360;

  const toRad = x => x * Math.PI / 180;

  // Equação do centro simplificada → longitude eclíptica da lua
  const lambda = Ml
    + 6.289 * Math.sin(toRad(Ml))
    - 1.274 * Math.sin(toRad(2*D - Ml))
    + 0.658 * Math.sin(toRad(2*D))
    - 0.214 * Math.sin(toRad(2*Ml))
    - 0.186 * Math.sin(toRad(M))
    - 0.114 * Math.sin(toRad(2*F));

  // Longitude eclíptica do sol (simplificada)
  const lambdaSun = 280.46646 + 36000.76983 * T
    + 1.914602 * Math.sin(toRad(M))
    + 0.019993 * Math.sin(toRad(2*M));

  // Elongação = diferença das longitudes
  let elong = ((lambda - lambdaSun) % 360 + 360) % 360;

  // Fase: 0–1 (0=Nova, 0.5=Cheia)
  const phase = elong / 360;

  // Iluminação %
  const illum = Math.round((1 - Math.cos(toRad(elong))) / 2 * 100);

  // Nome da fase
  let name, icon, grow_tip;
  if (phase < 0.0625 || phase >= 0.9375) {
    name = 'Lua Nova';         icon = '🌑';
    grow_tip = 'Energia nas raízes — ideal para transplantar e regar o substrato';
  } else if (phase < 0.1875) {
    name = 'Crescente';        icon = '🌒';
    grow_tip = 'Seiva em ascensão — bom para LST e adubação foliar leve';
  } else if (phase < 0.3125) {
    name = 'Quarto Crescente'; icon = '🌓';
    grow_tip = 'Crescimento acelerado — ótimo para defolha e treinamento';
  } else if (phase < 0.4375) {
    name = 'Gibosa Crescente'; icon = '🌔';
    grow_tip = 'Alta absorção — aumente a adubação gradualmente';
  } else if (phase < 0.5625) {
    name = 'Lua Cheia';        icon = '🌕';
    grow_tip = 'Máxima turgidez e resinas — melhor momento para colheita';
  } else if (phase < 0.6875) {
    name = 'Gibosa Minguante'; icon = '🌖';
    grow_tip = 'Seiva descendo — bom para flush e lavagem do substrato';
  } else if (phase < 0.8125) {
    name = 'Quarto Minguante'; icon = '🌗';
    grow_tip = 'Energia de limpeza — ideal para poda e remoção de folhas secas';
  } else {
    name = 'Minguante';        icon = '🌘';
    grow_tip = 'Descanso da planta — reduza intervenções, observe';
  }

  // Dias para próxima lua cheia
  const daysToFull = phase <= 0.5
    ? Math.round((0.5 - phase) * 29.53)
    : Math.round((1.5 - phase) * 29.53);

  return { phase, illum, name, icon, grow_tip, daysToFull };
}

function getLunarLine() {
  const l = getLunarData();
  return l.icon + ' ' + l.name + ' · ' + l.illum + '% iluminada · ' + l.grow_tip;
}

