            ${e.humidity ? `<span style="font-size:11px;background:var(--bg3);border:1px solid var(--border);padding:2px 7px;border-radius:6px;">💧 ${e.humidity}%</span>` : ''}
            ${e.ph ? `<span style="font-size:11px;background:var(--bg3);border:1px solid var(--border);padding:2px 7px;border-radius:6px;">pH ${e.ph}</span>` : ''}
            ${e.ec ? `<span style="font-size:11px;background:var(--bg3);border:1px solid var(--border);padding:2px 7px;border-radius:6px;">EC ${e.ec}</span>` : ''}
          </div>
          ${e.notes ? `<div style="font-size:12px;color:var(--text2);margin-top:5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${e.notes}</div>` : ''}
          ${(()=>{
            if (!e.fertilizers||!e.fertilizers.length) return '';
            const totalEC=e.fertilizers.reduce((s,f)=>s+(parseFloat(f.ec)||0),0);
            const colors=['#4ade80','#60a5fa','#fbbf24','#f87171','#a78bfa','#fb923c'];
            const chips=e.fertilizers.map((f,i)=>{
              const c=colors[i%colors.length];
              const isGran=(f.type||'liquido')==='granulado';
              const ecStr=f.ec?' +'+parseFloat(f.ec).toFixed(2):'';
              return '<span style="font-size:10px;padding:2px 6px;border-radius:6px;background:'+c+'18;border:1px solid '+c+'44;color:'+c+';">'+(isGran?'🟡':'💧')+' '+f.name+ecStr+'</span>';
            }).join('');
            const total=totalEC>0?'<span style="margin-left:auto;font-family:Space Mono,monospace;font-size:11px;font-weight:700;color:#a78bfa;">⚡'+totalEC.toFixed(2)+'</span>':'';
